  "outreach": {
    "cadenceDays": [3, 3, 3],
    "maxFollowUps": 3,
    "dailySendCap": 20,
    "signatureName": "Smart Pursuit",
    "replyTo": "smartpursuit3@gmail.com",
    "optOutLine": "If you would rather not hear from me again, reply “no thanks” and I will not follow up.",
