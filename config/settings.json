    "headlineOffsetPx": { "good": 300, "poor": 600 },
    "words": { "good": 300, "poor": 150 },
    "h1Count": { "good": 1, "poor": 3 },
    "thirdPartyCookies": { "good": 5, "poor": 20 },
    "readMoreLinks": { "good": 0, "poor": 5 }
